# Keep local, test, preview, and production credentials separate.
# The secret key is server-only; Clerk shares the publishable key with its UI.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Required outside development; exact origin without a trailing slash.
ADMIN_ORIGIN=

# Required to verify application permissions against Atlas.
MONGODB_URI=
MONGODB_DB_NAME=

# Admin server only: HTTPS deployment/revalidation hook for public changes.
PUBLIC_REGENERATION_WEBHOOK_URL=
PUBLIC_REGENERATION_WEBHOOK_SECRET=

# Trusted local setup only: save separately in apps/admin/.env.bootstrap.local.
# Use a temporary, database-scoped writer; do not replace the app's reader.
BOOTSTRAP_MONGODB_URI=
BOOTSTRAP_MONGODB_DB_NAME=
BOOTSTRAP_CLERK_USER_ID=

# Never prefix database, storage, or Clerk secrets with VITE_.
