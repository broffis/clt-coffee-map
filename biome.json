{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/*.{js,jsx,ts,tsx,json,jsonc,yaml,yml}",
      "!**/routeTree.gen.ts",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "overrides": [
    {
      "includes": [
        "apps/public/.release-please-manifest.json",
        "apps/admin/.release-please-manifest.json"
      ],
      "formatter": {
        "enabled": false
      }
    }
  ],
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
